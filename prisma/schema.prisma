generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model EventRegistration {
  id                  String             @id @default(cuid())
  firstName           String
  lastName            String
  gender              Gender
  email               String             @unique
  isCommunityMember   Boolean
  location            String
  locationOther       String?
  openSourceKnowledge Int                @db.SmallInt
  profession          Profession[]       @default([OTHER])
  professionOther     String?
  referralSource      ReferralSource     @default(OTHER)
  referralSourceOther String?
  newsletterSub       Boolean            @default(false)
  pipelineInterest    PipelineInterest   @default(NOT_SURE)
  interests           String?
  communityDetails    String?
  eventId             String?
  checkedIn           Boolean            @default(false)
  checkInTime         DateTime?
  createdAt           DateTime           @default(now())
  status              RegistrationStatus @default(PENDING)
  event               Event?             @relation(fields: [eventId], references: [id])

  @@map("event_registrations")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  @@map("users")
}

model Event {
  id             String              @id @default(cuid())
  name           String
  date           DateTime
  location       String
  description    String?
  targetCapacity Int                 @default(500)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  registrations  EventRegistration[]

  @@index([date])
  @@map("events")
}

enum Profession {
  STUDENT
  PROFESSIONAL_DEVELOPER
  HOBBYIST
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  FULLSTACK_DEVELOPER
  UI_UX_DESIGNER
  DEVOPS_ENGINEER
  QA_ENGINEER
  SECURITY_ENGINEER
  DATA_SCIENTIST
  AI_ML_ENGINEER
  PRODUCT_MANAGER
  PROJECT_MANAGER
  TECHNICAL_WRITER
  CONTENT_CREATOR
  COMMUNITY_MANAGER
  EDUCATOR
  FOUNDER
  IT_SUPPORT
  BUSINESS_ANALYST
  SMART_CONTRACT_DEVELOPER
  BLOCKCHAIN_DEVELOPER
  WEB3_DEVELOPER
  SOLIDITY_DEVELOPER
  DAPP_DEVELOPER
  TOKENOMICS_SPECIALIST
  NFT_DEVELOPER
  DEFI_DEVELOPER
  WEB3_SECURITY_AUDITOR
  BLOCKCHAIN_ARCHITECT
  OTHER
}

enum ReferralSource {
  SOCIAL_MEDIA
  FRIEND_COLLEAGUE
  ONLINE_SEARCH
  OTHER
}

enum PipelineInterest {
  YES
  NO
  NOT_SURE
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}
